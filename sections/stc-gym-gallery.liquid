{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .stc-gym-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    grid-template-rows: auto auto;
    gap: 1.4rem;
    margin-top: 3.6rem;
  }
  .stc-gym-grid .stc-gym-grid__main { grid-row: span 2; }
  @media screen and (max-width: 900px) {
    .stc-gym-grid { grid-template-columns: 1fr 1fr; }
    .stc-gym-grid .stc-gym-grid__main { grid-column: span 2; grid-row: auto; }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width" style="max-width: 68rem;">
    <p class="stc-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2 class="h1">{{ section.settings.heading }}</h2>
    <p style="font-size: 1.6rem; color: var(--stc-steel); margin-top: 1rem;">{{ section.settings.text }}</p>
  </div>
  <div class="page-width">
    <div class="stc-gym-grid">
      {%- for block in section.blocks -%}
        <div class="{% if forloop.first %}stc-gym-grid__main{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,600,900,1200', alt: block.settings.image.alt | default: block.settings.alt, style: 'width:100%;height:100%;object-fit:cover;border-radius:2px;display:block;' }}
          {%- else -%}
            <img src="{{ block.settings.fallback_asset | default: 'stc-hero.jpg' | asset_url }}" alt="{{ block.settings.alt | escape }}" loading="lazy" style="width:100%;height:100%;object-fit:cover;border-radius:2px;display:block;">
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "STC Gym Gallery",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Gym" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Clean. Well-equipped. Never crowded." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Four power racks, free weights, dumbbells up to 120 lbs, strength machines, and cardio — with room to actually move." },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 52 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 52 }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback_asset", "label": "Fallback theme asset filename (used until an image is picked above)" },
        { "type": "text", "id": "alt", "label": "Alt text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "STC Gym Gallery",
      "blocks": [
        { "type": "photo", "settings": { "fallback_asset": "stc-gym-1.jpg", "alt": "STC member deadlifting in a power rack" } },
        { "type": "photo", "settings": { "fallback_asset": "stc-gym-2.jpg", "alt": "STC member performing a back squat" } },
        { "type": "photo", "settings": { "fallback_asset": "stc-gym-3.jpg", "alt": "STC member performing a front squat" } },
        { "type": "photo", "settings": { "fallback_asset": "stc-gym-4.jpg", "alt": "Members training on the STC gym floor" } },
        { "type": "photo", "settings": { "fallback_asset": "stc-gym-5.jpg", "alt": "STC member with a lifting belt on, seated on a bench" } }
      ]
    }
  ]
}
{% endschema %}
