{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .stc-frills-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.4rem 4rem;
    margin: 2.4rem auto 0;
    max-width: 60rem;
    list-style: none;
    padding: 0;
  }
  @media screen and (max-width: 600px) { .stc-frills-list { grid-template-columns: 1fr; } }
  .stc-frills-list li { font-size: 1.6rem; font-weight: 600; padding-left: 2.2rem; position: relative; }
  .stc-frills-list li::before { content: '—'; position: absolute; left: 0; color: var(--stc-red); font-weight: 800; }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding" style="text-align: center;">
  <div class="page-width" style="max-width: 68rem;">
    <p class="stc-eyebrow" style="color: #E8778A;">{{ section.settings.eyebrow | escape }}</p>
    <h2 class="h1">{{ section.settings.heading }}</h2>
  </div>
  <div class="page-width">
    <ul class="stc-frills-list">
      {%- assign items = section.settings.items | newline_to_br | split: '<br />' -%}
      {%- for item in items -%}
        {%- assign item_trimmed = item | strip -%}
        {%- if item_trimmed != blank -%}<li>{{ item_trimmed }}</li>{%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "STC No Frills",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-3" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "No Frills. Just Work." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "STC isn't built around gimmicks." },
    { "type": "textarea", "id": "items", "label": "List items (one per line)", "default": "Quality equipment\nConvenient 24/7 access\nA clean place to train\nCoaching when you want it\nPeople who know your name" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 60 }
  ],
  "presets": [{ "name": "STC No Frills" }]
}
{% endschema %}
