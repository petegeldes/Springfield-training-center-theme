{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .stc-fw-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 4rem; align-items: start; }
  @media screen and (max-width: 900px) { .stc-fw-grid { grid-template-columns: 1fr; } }
  .stc-fw-grid img { width: 100%; border-radius: 2px; display: block; margin-bottom: 2rem; }
  .stc-fw-benefits { list-style: none; padding: 0; margin: 2.2rem 0 0; display: flex; flex-direction: column; gap: 1rem; }
  .stc-fw-benefits li { font-weight: 700; font-size: 1.6rem; }
  .stc-fw-form { background: #fff; border: 1px solid var(--stc-line); padding: 2.6rem; border-radius: 3px; }
  .stc-fw-form .field { margin-bottom: 1.6rem; }
  .stc-fw-form label { display: block; font-size: 1.2rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: var(--stc-steel); margin-bottom: 0.6rem; }
  .stc-fw-form input { width: 100%; border: 1px solid var(--stc-line); border-radius: 3px; padding: 1.2rem 1.4rem; font-size: 1.6rem; font-family: var(--font-body-family); }
  .stc-fw-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem; }
  @media screen and (max-width: 480px) { .stc-fw-row { grid-template-columns: 1fr; } }
  .stc-fw-success { background: var(--stc-navy); color: var(--stc-paper); padding: 3rem; border-radius: 3px; text-align: center; }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="stc-fw-grid">
      <div>
        <p class="stc-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h1 class="h0">{{ section.settings.heading }}</h1>
        <p style="font-size: 1.8rem; max-width: 46rem; margin-top: 1.4rem;">{{ section.settings.text }}</p>
        <ul class="stc-fw-benefits">
          {%- assign items = section.settings.benefits | newline_to_br | split: '<br />' -%}
          {%- for item in items -%}
            {%- assign item_trimmed = item | strip -%}
            {%- if item_trimmed != blank -%}<li>✓ {{ item_trimmed }}</li>{%- endif -%}
          {%- endfor -%}
        </ul>
        <p style="margin-top: 1.8rem; font-size: 1.5rem; color: var(--stc-steel);">{{ section.settings.address_line }}</p>
      </div>
      <div>
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'eager', widths: '400,600,900,1200', alt: 'Springfield Training Center' }}
        {%- else -%}
          <img src="{{ 'stc-freeweek.jpg' | asset_url }}" alt="Springfield Training Center" loading="eager">
        {%- endif -%}

        {%- form 'contact', id: 'STCFreeWeekForm', class: 'stc-fw-form' -%}
          {%- if form.posted_successfully? -%}
            <div class="stc-fw-success">
              <h3 style="color:#fff; margin-bottom: 1rem;">You're in{% if form.name %}, {{ form.name | split: ' ' | first }}{% endif %}.</h3>
              <p>Someone from STC will reach out to get your free week started. See you in Springfield.</p>
            </div>
          {%- else -%}
            <h3 style="margin-bottom: 1.6rem;">Claim your free week</h3>
            <input type="hidden" name="contact[tags]" value="free-week-lead">
            <div class="stc-fw-row">
              <div class="field">
                <label for="STCFreeWeek-first">First name</label>
                <input type="text" id="STCFreeWeek-first" name="contact[First name]" required>
              </div>
              <div class="field">
                <label for="STCFreeWeek-last">Last name</label>
                <input type="text" id="STCFreeWeek-last" name="contact[Last name]" required>
              </div>
            </div>
            <div class="field">
              <label for="STCFreeWeek-email">Email</label>
              <input type="email" id="STCFreeWeek-email" name="contact[email]" required>
            </div>
            <div class="field">
              <label for="STCFreeWeek-phone">Mobile phone</label>
              <input type="tel" id="STCFreeWeek-phone" name="contact[Phone]" required>
            </div>
            <button type="submit" class="button button--primary" style="width: 100%;">Get My Free Week</button>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "STC Free Week",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Free 7-Day Trial" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Try STC free for 7 days." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Full access to the gym floor — racks, free weights, dumbbells to 120 lbs, machines, and cardio. No pressure, no obligation." },
    { "type": "textarea", "id": "benefits", "label": "Benefits (one per line)", "default": "7 full days of gym access\nSee the space, the equipment, the people\nNo cost, no commitment" },
    { "type": "text", "id": "address_line", "label": "Address line", "default": "631 S 1st Street, Bay #6 · Springfield, NE" },
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 44 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 52 }
  ],
  "presets": [{ "name": "STC Free Week" }]
}
{% endschema %}
