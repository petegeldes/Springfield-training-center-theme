{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .stc-testi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-top: 3.6rem; }
  @media screen and (max-width: 900px) { .stc-testi-grid { grid-template-columns: 1fr; } }
  .stc-testi { background: #fff; border: 1px solid var(--stc-line); padding: 2.6rem; border-radius: 3px; }
  .stc-testi p.stc-testi__quote { font-size: 1.6rem; font-style: italic; margin: 0; }
  .stc-testi p.stc-testi__who { margin-top: 1.4rem; font-size: 1.2rem; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; color: var(--stc-steel); }
  .stc-testi p.stc-testi__flag { margin-top: 1rem; font-size: 1.1rem; color: var(--stc-red); font-weight: 700; }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width" style="max-width: 68rem;">
    <p class="stc-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2 class="h1">{{ section.settings.heading }}</h2>
  </div>
  <div class="page-width">
    <div class="stc-testi-grid">
      {%- for block in section.blocks -%}
        <div class="stc-testi" {{ block.shopify_attributes }}>
          <p class="stc-testi__quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>
          <p class="stc-testi__who">— {{ block.settings.name | escape }}</p>
          {%- if block.settings.show_placeholder_flag -%}
            <p class="stc-testi__flag">PLACEHOLDER — replace with a real review before launch</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "STC Testimonials",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What Members Say" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real reviews go here before launch." },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 52 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 52 }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "[Placeholder — replace with a real member/Google review before launch.]" },
        { "type": "text", "id": "name", "label": "Name", "default": "Member name" },
        { "type": "checkbox", "id": "show_placeholder_flag", "label": "Show placeholder warning", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "STC Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
