{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .stc-training-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4.4rem; align-items: center; }
  @media screen and (max-width: 900px) { .stc-training-grid { grid-template-columns: 1fr; } }
  .stc-training-grid img { width: 100%; border-radius: 2px; display: block; aspect-ratio: 4/5; object-fit: cover; }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width" style="max-width: 68rem; margin-bottom: 2rem;">
    <p class="stc-eyebrow">{{ section.settings.eyebrow_top | escape }}</p>
    <h1 class="h0">{{ section.settings.heading_top }}</h1>
  </div>
  <div class="page-width">
    <div class="stc-training-grid">
      <div>
        <p class="stc-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h2 class="h1">{{ section.settings.heading }}</h2>
        <p style="font-size: 1.6rem; margin-top: 1.4rem;">{{ section.settings.text_1 }}</p>
        <p style="font-size: 1.6rem; margin-top: 1.4rem;">{{ section.settings.text_2 }}</p>
        <table class="stc-schedule">
          <thead><tr><th>Day</th><th>Sessions</th></tr></thead>
          <tbody>
            <tr><td>Monday</td><td>5:30 AM &amp; 6:00 PM</td></tr>
            <tr><td>Wednesday</td><td>5:30 AM &amp; 6:00 PM</td></tr>
            <tr><td>Friday</td><td>5:30 AM &amp; 5:00 PM</td></tr>
            <tr><td>Saturday</td><td>7:00 AM</td></tr>
          </tbody>
        </table>
        <p style="font-size: 1.3rem; color: var(--stc-steel); margin-bottom: 2rem;">7 coached sessions available every week.</p>
        <a href="{{ section.settings.button_link }}" class="button button--primary">{{ section.settings.button_label | escape }}</a>
      </div>
      <div>
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'eager', widths: '400,600,800,1000', alt: 'Coached session in progress at STC' }}
        {%- else -%}
          <img src="{{ 'stc-training-coach.jpg' | asset_url }}" alt="Coached session in progress at STC" loading="eager">
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "STC Training Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow_top", "label": "Top eyebrow", "default": "Training" },
    { "type": "textarea", "id": "heading_top", "label": "Top heading", "default": "You don't need more equipment. You need to know what to do with it." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "STC Coached" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Programming. Coaching. Unlimited access." },
    { "type": "textarea", "id": "text_1", "label": "Paragraph 1", "default": "STC Coached is built for people who want direction, not just a door badge. You get personal workout programming, coached training sessions, and unlimited 24/7 gym access — all in one membership." },
    { "type": "textarea", "id": "text_2", "label": "Paragraph 2", "default": "This isn't 1-on-1 personal training. It's programming, coached classes, and full access, run by Clay." },
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Join STC Coached — $90/mo" },
    { "type": "url", "id": "button_link", "label": "Button link (Square Payment Link or /pages/join)" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 44 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 52 }
  ],
  "presets": [{ "name": "STC Training Hero" }]
}
{% endschema %}
