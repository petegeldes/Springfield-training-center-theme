{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .stc-who-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.4rem; margin-top: 3.6rem; }
  @media screen and (max-width: 900px) { .stc-who-grid { grid-template-columns: 1fr 1fr; } }
  .stc-who-grid img { width: 100%; aspect-ratio: 4/5; object-fit: cover; border-radius: 2px; display: block; }
  .stc-who-grid .stc-who-label { margin-top: 1rem; font-weight: 800; font-size: 1.2rem; letter-spacing: 0.05em; text-transform: uppercase; }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width" style="max-width: 68rem;">
    <p class="stc-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2 class="h1">{{ section.settings.heading }}</h2>
  </div>
  <div class="page-width">
    <div class="stc-who-grid">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300,500,800', alt: block.settings.image.alt | default: block.settings.label, style: 'width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:2px;display:block;' }}
          {%- else -%}
            <img src="{{ block.settings.fallback_asset | default: 'stc-hero.jpg' | asset_url }}" alt="{{ block.settings.label | escape }}" loading="lazy" style="width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:2px;display:block;">
          {%- endif -%}
          <p class="stc-who-label">{{ block.settings.label | escape }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "STC Who Trains Here",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Who Trains Here" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Beginners. Athletes. Everyone in between." },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 52 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 52 }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback_asset", "label": "Fallback theme asset filename" },
        { "type": "text", "id": "label", "label": "Label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "STC Who Trains Here",
      "blocks": [
        { "type": "photo", "settings": { "fallback_asset": "stc-who-woman.jpg", "label": "Adults getting back at it" } },
        { "type": "photo", "settings": { "fallback_asset": "stc-who-man.jpg", "label": "Everyday strength" } },
        { "type": "photo", "settings": { "fallback_asset": "stc-who-student.jpg", "label": "Student athletes" } },
        { "type": "photo", "settings": { "fallback_asset": "stc-who-group.jpg", "label": "A community, not a crowd" } }
      ]
    }
  ]
}
{% endschema %}
