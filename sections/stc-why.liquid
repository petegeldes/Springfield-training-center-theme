{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .stc-why-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--stc-line);
    border: 1px solid var(--stc-line);
    margin-top: 3.6rem;
  }
  @media screen and (max-width: 989px) { .stc-why-grid { grid-template-columns: 1fr 1fr; } }
  @media screen and (max-width: 480px) { .stc-why-grid { grid-template-columns: 1fr; } }
  .stc-why-tile { background: inherit; padding: 2.6rem 2.2rem; }
  .stc-why-tile h3 { font-size: 1.6rem; margin: 0 0 0.8rem; }
  .stc-why-tile p { margin: 0; color: var(--stc-steel); font-size: 1.4rem; }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width" style="max-width: 68rem;">
    <p class="stc-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2 class="h1">{{ section.settings.heading }}</h2>
  </div>
  <div class="page-width">
    <div class="stc-why-grid" style="background-color: var(--stc-cream);">
      {%- for block in section.blocks -%}
        <div class="stc-why-tile" style="background-color: {{ section.settings.tile_background }};" {{ block.shopify_attributes }}>
          <h3>{{ block.settings.title | escape }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "STC Why Tiles",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "color", "id": "tile_background", "label": "Tile background", "default": "#F6F3EC" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why STC" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A real gym, close to home." },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 52 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 52 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "24/7 Access" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Train when it works for you." }
      ]
    }
  ],
  "presets": [
    {
      "name": "STC Why Tiles",
      "blocks": [
        { "type": "tile", "settings": { "title": "24/7 Access", "text": "Train when it works for you." } },
        { "type": "tile", "settings": { "title": "Everything You Need", "text": "Four racks, free weights, dumbbells to 120, strength machines and cardio." } },
        { "type": "tile", "settings": { "title": "Close to Home", "text": "A real gym right here in Springfield." } },
        { "type": "tile", "settings": { "title": "Real Coaching", "text": "Need more than access? Get programming and coached training from someone who actually knows you." } }
      ]
    }
  ]
}
{% endschema %}
