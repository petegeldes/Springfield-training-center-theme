{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .stc-final-list { list-style: none; padding: 0; margin: 0 auto 3rem; font-size: 1.8rem; font-weight: 700; display: flex; flex-direction: column; gap: 0.6rem; width: fit-content; }
  .stc-final-ctas { display: flex; justify-content: center; gap: 1.4rem; flex-wrap: wrap; }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding" style="text-align: center;">
  <div class="page-width">
    <h2 class="h1">{{ section.settings.heading }}</h2>
    <ul class="stc-final-list">
      {%- assign items = section.settings.items | newline_to_br | split: '<br />' -%}
      {%- for item in items -%}
        {%- assign item_trimmed = item | strip -%}
        {%- if item_trimmed != blank -%}<li>{{ item_trimmed }}</li>{%- endif -%}
      {%- endfor -%}
    </ul>
    <div class="stc-final-ctas">
      {%- if section.settings.button_label_1 != blank -%}
        <a href="{{ section.settings.button_link_1 }}" class="button button--primary">{{ section.settings.button_label_1 | escape }}</a>
      {%- endif -%}
      {%- if section.settings.button_label_2 != blank -%}
        <a href="{{ section.settings.button_link_2 }}" class="button button--secondary">{{ section.settings.button_label_2 | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "STC Final CTA",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-3" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your gym is right here." },
    { "type": "textarea", "id": "items", "label": "List items (one per line)", "default": "24/7 access\nReal equipment\nReal coaching\nLocal community" },
    { "type": "text", "id": "button_label_1", "label": "Primary button label", "default": "Join STC" },
    { "type": "url", "id": "button_link_1", "label": "Primary button link" },
    { "type": "text", "id": "button_label_2", "label": "Secondary button label", "default": "Try STC Free" },
    { "type": "url", "id": "button_link_2", "label": "Secondary button link" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 68 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 68 }
  ],
  "presets": [{ "name": "STC Final CTA" }]
}
{% endschema %}
