{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .stc-loc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
  @media screen and (max-width: 900px) { .stc-loc-grid { grid-template-columns: 1fr; } }
  .stc-loc-facts { display: flex; flex-direction: column; gap: 1.6rem; margin-top: 2.2rem; }
  .stc-loc-facts .row { display: flex; gap: 1.4rem; }
  .stc-loc-facts .k { font-weight: 800; font-size: 1.1rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--stc-red); min-width: 12rem; }
  .stc-map-wrap { border: 1px solid var(--stc-line); border-radius: 3px; overflow: hidden; aspect-ratio: 4/3; }
  .stc-map-wrap iframe { width: 100%; height: 100%; border: 0; }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="stc-loc-grid">
      <div>
        <p class="stc-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h2 class="h1">{{ section.settings.heading }}</h2>
        <div class="stc-loc-facts">
          <div class="row"><span class="k">Address</span><span>{{ section.settings.address }}</span></div>
          <div class="row"><span class="k">Access</span><span>{{ section.settings.access_line }}</span></div>
          <div class="row"><span class="k">Contact</span><span>{{ section.settings.contact_line }}</span></div>
        </div>
        {%- if section.settings.directions_url != blank -%}
          <div style="margin-top: 2.2rem;">
            <a href="{{ section.settings.directions_url }}" class="button button--secondary" target="_blank" rel="noopener">Get Directions</a>
          </div>
        {%- endif -%}
      </div>
      <div class="stc-map-wrap">
        {%- if section.settings.map_embed_url != blank -%}
          <iframe title="Map to Springfield Training Center" loading="lazy" src="{{ section.settings.map_embed_url }}"></iframe>
        {%- else -%}
          <img src="{{ 'stc-location.jpg' | asset_url }}" alt="Springfield Training Center entrance" loading="lazy" style="width:100%;height:100%;object-fit:cover;">
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "STC Location",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Location" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Springfield, Nebraska." },
    { "type": "textarea", "id": "address", "label": "Address", "default": "631 S 1st Street, Bay #6, Springfield, NE 68059" },
    { "type": "text", "id": "access_line", "label": "Access line", "default": "24/7 for members" },
    { "type": "text", "id": "contact_line", "label": "Contact line", "default": "402-350-0546" },
    { "type": "url", "id": "directions_url", "label": "Get Directions link", "default": "https://www.google.com/maps/search/?api=1&query=631+S+1st+Street+Springfield+NE" },
    { "type": "text", "id": "map_embed_url", "label": "Google Maps embed URL (Maps > Share > Embed a map)", "info": "Leave blank to show a photo instead of a live map." },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 52 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 52 }
  ],
  "presets": [{ "name": "STC Location" }]
}
{% endschema %}
